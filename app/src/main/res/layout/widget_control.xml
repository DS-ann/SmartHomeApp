<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:background="#222222">

    <!-- Row 1: Lights -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/light1Button"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="Light 1"
            android:textAllCaps="false"
            android:background="@drawable/button_round_orange"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/light2Button"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="Light 2"
            android:textAllCaps="false"
            android:background="@drawable/button_round_orange"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>
    </LinearLayout>

    <!-- Row 2: Fans -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/fan1Button"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="Fan 1"
            android:textAllCaps="false"
            android:background="@drawable/button_round_green"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/fan2Button"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="Fan 2"
            android:textAllCaps="false"
            android:background="@drawable/button_round_green"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>
    </LinearLayout>

</LinearLayout>
